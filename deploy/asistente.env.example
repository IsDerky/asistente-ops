# /etc/asistente.env (root, 600). install.sh lo crea a partir de este fichero.

# Discord: token del bot y tu ID (el mismo que OWNER_DISCORD_ID en bot/src/config.ts)
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Groq (plan gratuito): https://console.groq.com/keys
GROQ_API_KEY=
# ASSISTANT_MODEL=openai/gpt-oss-120b   (ver: bun src/cli.ts modelos)
ASSISTANT_SUMMARY_HOUR=9

# Recolector
OPS_SNAPSHOT=/var/lib/ops-collect/snapshot.json

# Vigilante externo (watchdog/), opcional
OPS_WATCHDOG_URL=
OPS_WATCHDOG_TOKEN=

# Dominios cuya caducidad se vigila por RDAP, separados por comas
OPS_DOMAINS=

# Pterodactyl, opcional: Application API con clave de SOLO LECTURA
PTERODACTYL_URL=
PTERODACTYL_API_KEY=

# App web propia con API de ops, opcional
BENTONIME_URL=http://127.0.0.1:3939
OPS_API_TOKEN=

# Oficina, opcional
CLAUDE_HOOK_TOKEN=
SPOTIFY_NOW_URL=
OFICINA_LAT=40.4168
OFICINA_LON=-3.7038
