def run(cmd, timeout=30):
    """stdout de un comando, o None si falla (el recolector nunca se cae)."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def section(fn):
    try:
        return fn()
    except Exception as e:  # una sección rota no tumba las demás
        return {"error": f"{type(e).__name__}: {e}"}


def system():
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, value = line.split(":", 1)
            mem[key] = int(value.split()[0]) * 1024
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])
    load1, load5, load15 = os.getloadavg()
    disks = {}
    for path in ["/", "/var/lib/pterodactyl"]:
        if os.path.exists(path):
            du = shutil.disk_usage(path)
            disks[path] = {"total": du.total, "used": du.used, "free": du.free}
    return {
        "hostname": os.uname().nodename,
        "uptime_s": int(uptime),
        "load": [round(load1, 2), round(load5, 2), round(load15, 2)],
        "cpus": os.cpu_count(),
        "mem_total": mem.get("MemTotal"),
        "mem_available": mem.get("MemAvailable"),
        "swap_used": mem.get("SwapTotal", 0) - mem.get("SwapFree", 0),
        "disks": disks,
    }


def smart():
    try:
        r = subprocess.run(["smartctl", "-j", "-a", DISK], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        return {"error": f"smartctl no disponible: {e}"}
    # El código de salida es una máscara de bits: solo los bits 0-1 (línea de
    # órdenes, no se pudo abrir el disco) son fatales. El resto (p. ej. 64:
    # hay entradas en el registro de errores) vienen con datos válidos.
    if r.returncode & 0b11:
        return {"error": f"smartctl falló (código {r.returncode})"}
    d = json.loads(r.stdout)
    attrs = {a["name"]: a for a in d.get("ata_smart_attributes", {}).get("table", [])}

    def raw(name):
        a = attrs.get(name)
        return a["raw"]["value"] if a else None

    def value(name):
        a = attrs.get(name)
        return a["value"] if a else None

    return {
        "device": DISK,
        "smartctl_exit_bits": r.returncode,
        "model": d.get("model_name"),
        "passed": d.get("smart_status", {}).get("passed"),
        "temperature_c": d.get("temperature", {}).get("current"),
        "power_on_hours": d.get("power_on_time", {}).get("hours"),
        "wear_remaining_pct": value("Wear_Leveling_Count"),
        "reallocated_sectors": raw("Reallocated_Sector_Ct"),
        "total_lbas_written": raw("Total_LBAs_Written"),
    }


def unit_state(unit, props):
    out = run(["systemctl", "show", unit, "--timestamp=unix", "-p", ",".join(props)])
    if out is None:
        return None
    state = {}
    for line in out.splitlines():
        key, _, val = line.partition("=")
        if val.startswith("@"):
            val = int(val[1:])
        state[key] = val
    return state


def services():
    out = {}
    for unit in SERVICES:
        s = unit_state(unit, ["ActiveState", "SubState", "LoadState", "NRestarts"])
        if s and s.get("LoadState") != "not-found":
            out[unit] = s
    for unit in TIMERS:
        s = unit_state(unit, ["ActiveState", "NextElapseUSecRealtime", "LastTriggerUSec"])
        if s:
            out[unit] = s
    return out


def backups():
