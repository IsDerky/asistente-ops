def panel_names():
    """uuid del contenedor -> nombre del servidor en el panel (solo lectura)."""
    out = run(["mariadb", "-N", "-B", "-e", "SELECT uuid, name FROM panel.servers"])
    names = {}
    for line in (out or "").splitlines():
        uuid, _, name = line.partition("\t")
        names[uuid] = name
    return names


def parse_size(text):
    units = {"B": 1, "KB": 1e3, "MB": 1e6, "GB": 1e9, "KIB": 1024, "MIB": 1024**2, "GIB": 1024**3}
    text = text.strip().upper()
    for unit in sorted(units, key=len, reverse=True):
        if text.endswith(unit):
            return int(float(text[: -len(unit)]) * units[unit])
    return None


def clients():
    out = run(["docker", "stats", "--no-stream", "--format", "{{json .}}"], timeout=60)
    if out is None:
        return {"error": "docker stats falló"}
    names = panel_names()
    result = []
    for line in out.splitlines():
        c = json.loads(line)
        used, _, limit = c.get("MemUsage", "").partition("/")
        name = c.get("Name", "")
        result.append(
            {
                "container": name,
                "server": names.get(name),  # None: no es un servidor del panel
                "cpu_pct": float(c.get("CPUPerc", "0").rstrip("%") or 0),
                "mem_bytes": parse_size(used),
                "mem_limit_bytes": parse_size(limit),
            }
        )
    return result


def certificates():
    """Caducidad de cada certificado de Let's Encrypt (la carpeta es solo de root)."""
    out = {}
    if not os.path.isdir(LETSENCRYPT):
        return out
    for name in sorted(os.listdir(LETSENCRYPT)):
        cert = os.path.join(LETSENCRYPT, name, "cert.pem")
        if not os.path.exists(cert):
            continue
        end = run(["openssl", "x509", "-noout", "-enddate", "-in", cert])
        if not end:
            out[name] = {"error": "no se pudo leer el certificado"}
            continue
        # notAfter=Jan 27 04:07:19 2027 GMT
        when = datetime.strptime(end.strip().split("=", 1)[1], "%b %d %H:%M:%S %Y %Z")
        out[name] = {"expires_at": when.replace(tzinfo=timezone.utc).isoformat()}
    return out


