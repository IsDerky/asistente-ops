# --- Logs -------------------------------------------------------------------
# Cada aviso se reduce a una plantilla sin números, IDs, IPs ni rutas: dos
# mensajes que solo cambian en eso tienen la misma huella. El bot decide qué
# huellas son nuevas o se disparan; aquí solo se cuentan.

NORMALIZERS = [
    (re.compile(r"\x1b\[[0-9;]*m"), ""),
    # Fechas tipo "[Oct 28 12:34:56]": si no, cada mes cambiarían todas las huellas.
    (re.compile(r"\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\b"), "<mes>"),
    (re.compile(r"\b(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)\b"), "<día>"),
    (re.compile(r"\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b", re.I), "<uuid>"),
    (re.compile(r"\b(?:[0-9a-f]{2}:){5,}[0-9a-f]{2}\b", re.I), "<mac>"),
    (re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}(?::\d+)?\b"), "<ip>"),
    (re.compile(r"\b(?:[0-9a-f]{0,4}:){2,7}[0-9a-f]{1,4}\b", re.I), "<ip>"),
    (re.compile(r"(?<![\w<])/[\w.@%+=:,~-]+(?:/[\w.@%+=:,~-]*)*"), "<ruta>"),
    (re.compile(r"\b[0-9a-f]{8,}\b", re.I), "<hex>"),
    (re.compile(r"\b[A-Za-z0-9_-]{32,}\b"), "<token>"),
    (re.compile(r"\d+(?:\.\d+)?"), "<n>"),
    (re.compile(r"\s+"), " "),
]
SECRETS = [
    (re.compile(r"(?i)\b(pass(?:word)?|token|secret|api[_-]?key|authorization)([=:]\s*)\S+"), r"\1\2<oculto>"),
    (re.compile(r"\b[A-Za-z0-9_-]{32,}\b"), "<oculto>"),
]


def normalize(msg):
    for pattern, repl in NORMALIZERS:
        msg = pattern.sub(repl, msg)
    return msg.strip()


def mask(msg):
    """El ejemplo que llega al DM: el mensaje real, sin cosas con pinta de secreto."""
    for pattern, repl in SECRETS:
        msg = pattern.sub(repl, msg)
    return msg.strip()


def message_text(raw):
    if isinstance(raw, list):  # journald manda los mensajes binarios como lista de bytes
        return bytes(raw).decode("utf-8", "replace")
    return raw or ""


def unit_name(entry):
    unit = (
        entry.get("_SYSTEMD_UNIT")
        or entry.get("_SYSTEMD_USER_UNIT")
        or entry.get("SYSLOG_IDENTIFIER")
        or "?"
    )
    # user@1001.service, session-604.scope… son la misma cosa con otro número.
    return re.sub(r"\d+", "<n>", unit)


def interesting(entry, msg):
    if int(entry.get("PRIORITY", 6)) <= 4:  # warning o peor
        return True
    unit = entry.get("_SYSTEMD_UNIT", "")
    watched = unit in WATCH_UNITS or unit.startswith(WATCH_PREFIXES)
    return watched and bool(ERROR_WORDS.search(msg))


def read_journal(args):
    """Lee el journal; devuelve (código de salida, entradas parseadas)."""
    proc = subprocess.Popen(
        ["journalctl", "-o", "json", "--no-pager", "-q", *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        errors="replace",
    )
    entries = []
    for line in proc.stdout:
        try:
            entries.append(json.loads(line))
        except ValueError:
            continue
    return proc.wait(), entries


def fail2ban():
    """IPs baneadas ahora mismo por cada jail (para la dashboard del honeypot)."""
    out = run(["fail2ban-client", "status"])
    if out is None:
        return {"error": "fail2ban-client no responde"}
    m = re.search(r"Jail list:\s*(.*)", out)
    jails = [j.strip() for j in (m.group(1) if m else "").split(",") if j.strip()]
    result = {}
    for jail in jails:
        st = run(["fail2ban-client", "status", jail]) or ""
        banned = re.search(r"Banned IP list:\s*(.*)", st)
        total = re.search(r"Total banned:\s*(\d+)", st)
        result[jail] = {
            "banned": (banned.group(1).split() if banned else [])[:500],
            "total_banned": int(total.group(1)) if total else 0,
        }
    return result


WINGS_CONFIG = os.environ.get("OPS_WINGS_CONFIG", "/etc/pterodactyl/config.yml")


def wings():
    """Estado en directo de TODOS los servidores de este nodo, según Wings.

    Solo se leen el estado y los números de consumo; la respuesta de Wings
    trae también la configuración de cada servidor (variables de entorno de los
    clientes), que se descarta sin guardarla.
    """
    cfg = {}
    with open(WINGS_CONFIG) as f:
        section = None
        for line in f:
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            indent = len(line) - len(line.lstrip())
            key, _, value = line.strip().partition(":")
            value = value.strip().strip("'\"")
            if indent == 0:
                section = key
                if value:
                    cfg[key] = value
            elif section == "api" and indent == 2:
                cfg[f"api.{key}"] = value
            elif section == "api" and key == "enabled":
                cfg["api.ssl"] = value
            elif section == "api" and key == "cert":
                cfg["api.cert"] = value
    token = cfg.get("token")
    if not token:
        return {"error": "sin token en la config de Wings"}
    port = cfg.get("api.port", "8080")
    host = re.sub(r"^https?://", "", cfg.get("remote", "")).split("/")[0]
    # El certificado de Wings es para su dominio público: se resuelve a 127.0.0.1.
    cert_host = re.search(r"/live/([^/]+)/", cfg.get("api.cert", ""))
    node = os.environ.get("OPS_WINGS_HOST") or (cert_host.group(1) if cert_host else "localhost")
    scheme = "https" if cfg.get("api.ssl", "false").lower() in ("true", "enabled") else "http"
    # El token va por la entrada estándar (-H @-): en la línea de órdenes lo
    # vería cualquiera con `ps`.
    try:
        r = subprocess.run(
            [
                "curl", "-fsS", "--max-time", "15",
                "--resolve", f"{node}:{port}:127.0.0.1",
                "-H", "@-",
                "-H", "Accept: application/json",
                f"{scheme}://{node}:{port}/api/servers",
            ],
            input=f"Authorization: Bearer {token}\n",
            capture_output=True,
            text=True,
            timeout=20,
        )
        out = r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        out = None
    if out is None:
        return {"error": f"Wings no responde en {scheme}://{node}:{port} (panel {host})"}
    servers = []
    for s in json.loads(out):
        u = s.get("utilization") or {}
        conf = s.get("configuration") or {}
        servers.append(
            {
                "uuid": conf.get("uuid"),
                "state": u.get("state") or s.get("state"),
                "suspended": bool(s.get("is_suspended")),
                "mem_bytes": u.get("memory_bytes"),
                "mem_limit_bytes": u.get("memory_limit_bytes"),
                "cpu_pct": round(float(u.get("cpu_absolute") or 0), 1),
                "disk_bytes": u.get("disk_bytes"),
                "uptime_ms": u.get("uptime"),
            }
        )
    return servers


WINGS_NODES = os.environ.get("OPS_WINGS_NODES", "/etc/ops-collect/wings-nodes.env")


def wings_remote():
    """Estado de los servidores de los OTROS nodos. Los tokens de sus Wings los
    puso Alex a mano en WINGS_NODES (una línea `dominio[:puerto]=token`, solo
    root). Solo lectura (GET /api/servers); la configuración se descarta."""
    try:
        with open(WINGS_NODES) as f:
            lines = [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]
    except FileNotFoundError:
        return {}
    out = {}
    for line in lines:
        host, _, token = line.partition("=")
        host, token = host.strip(), token.strip()
        if not host or not token:
            continue
        hostport = host if ":" in host else f"{host}:8080"
        try:
            r = subprocess.run(
                ["curl", "-fsS", "--max-time", "15", "-H", "@-", "-H", "Accept: application/json", f"https://{hostport}/api/servers"],
                input=f"Authorization: Bearer {token}\n",  # por stdin: en argv lo vería cualquiera con `ps`
                capture_output=True,
                text=True,
                timeout=20,
            )
        except (OSError, subprocess.TimeoutExpired):
            out[host] = {"error": "no responde"}
            continue
        if r.returncode != 0:
            out[host] = {"error": f"curl {r.returncode}: {r.stderr.strip()[:120]}"}
            continue
        servers = []
        for s in json.loads(r.stdout):
            u = s.get("utilization") or {}
            conf = s.get("configuration") or {}
            servers.append(
                {
                    "uuid": conf.get("uuid"),
                    "state": u.get("state") or s.get("state"),
                    "suspended": bool(s.get("is_suspended")),
                    "mem_bytes": u.get("memory_bytes"),
                    "mem_limit_bytes": u.get("memory_limit_bytes"),
                    "cpu_pct": round(float(u.get("cpu_absolute") or 0), 1),
                    "disk_bytes": u.get("disk_bytes"),
                    "uptime_ms": u.get("uptime"),
                }
            )
        out[host] = {"servers": servers}
    return out


