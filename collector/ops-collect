# --- Ataques ------------------------------------------------------------------
# Se agrupan por (tipo, IP) en cada pasada. Privacidad de los clientes:
#  - Wings: solo se guarda IP y usuario cuando el usuario no tiene el formato de
#    Pterodactyl (usuario.id), o sea, seguro que no es un cliente. Los demás
#    fallos de SFTP (un cliente puede equivocarse) solo suman a un contador.
#  - nginx: solo IPs públicas y peticiones con firma de escáner; las normales
#    al panel no se miran.
#  - Cowrie: todo, es el honeypot.

WINGS_INVALID = re.compile(r"failed to validate user credentials \(invalid format\) ip=([0-9a-f.:]+?):\d+\b.*?username=(\S*)")
WINGS_NOAUTH = "sftp: failed to accept inbound connection error=[ssh: no auth passed yet"
NGINX_LINE = re.compile(r'^(\S+) \S+ \S+ \[([^\]]+)\] "((?:[^"\\]|\\.)*)" (\d{3}) \S+ "(?:[^"\\]|\\.)*" "((?:[^"\\]|\\.)*)"')
PROBES = re.compile(
    r"(wp-|xmlrpc|\.env|\.git/|phpmyadmin|/pma|/cgi-bin|/boaform|/hnap1|/actuator|phpunit|eval-stdin|"
    r"/solr|/console|/manager/html|/owa/|autodiscover|/\.aws|/\.ssh|/config\.json|/geoserver|/druid|"
    r"/shell|/setup\.cgi|/gponform|/remote/login|\.ds_store|/server-status|/admin\.php|\.action\b|"
    r"/jenkins|/telescope|/_ignition|\.\./|%2e%2e|/etc/passwd|/bin/sh|/wls-wsat|/sdk|/ecp/|/cdn-cgi/bm)",
    re.I,
)
LIMIT_KEYS = 50


class Attacks:
    def __init__(self):
        self.by = {}
        self.sftp_failed_other = 0

    def hit(self, kind, ip, n=1):
        r = self.by.get((kind, ip))
        if r is None:
            r = self.by[(kind, ip)] = {"kind": kind, "ip": ip, "count": 0}
        r["count"] += n
        return r

    @staticmethod
    def seen(r, ts):
        """Hora real (ms) del último evento de la IP en el lote: el feed y la
        línea de tiempo la usan en vez de la hora de la pasada."""
        if ts and ts > r.get("ts", 0):
            r["ts"] = ts

    limit = LIMIT_KEYS

    def bump(self, r, field, key, n=1):
        d = r.setdefault(field, {})
        if key in d or len(d) < self.limit:
            d[key] = d.get(key, 0) + n

    def push(self, r, field, item):
        items = r.setdefault(field, [])
        if len(items) < self.limit:
            items.append(item)

    def out(self):
        return sorted(self.by.values(), key=lambda r: -r["count"])[:2000]


_own_ips = None


def own_ips():
    global _own_ips
    if _own_ips is None:
        import socket

        _own_ips = {ip.strip() for ip in OWN_IPS_EXTRA if ip.strip()}
        for host in OWN_HOSTS:
            try:
                _own_ips |= {a[4][0] for a in socket.getaddrinfo(host.strip(), None)}
            except (OSError, UnicodeError):
                pass
    return _own_ips


def public_ip(ip):
    try:
        return ipaddress.ip_address(ip).is_global and ip not in own_ips()
    except ValueError:
        return False


def journal_ms(e):
    try:
        return int(e["__REALTIME_TIMESTAMP"]) // 1000
    except (KeyError, ValueError, TypeError):
        return None


def iso_ms(s):
    """'2026-11-01T15:27:01.123456Z' (Cowrie) → ms, o None."""
    try:
        return int(datetime.fromisoformat(str(s).replace("Z", "+00:00")).timestamp() * 1000)
    except ValueError:
        return None


def nginx_ms(s):
    """'01/Nov/2026:16:27:01 +0100' → ms, o None."""
    try:
        return int(datetime.strptime(s, "%d/%b/%Y:%H:%M:%S %z").timestamp() * 1000)
    except ValueError:
        return None


def wings_attack(attacks, msg, ts=None):
    m = WINGS_INVALID.search(msg)
    if m and public_ip(m.group(1)):
        r = attacks.hit("sftp", m.group(1))
        attacks.seen(r, ts)
        attacks.bump(r, "users", m.group(2)[:40])
    elif WINGS_NOAUTH in msg or "failed to validate user credentials" in msg:
        attacks.sftp_failed_other += 1


def nginx_attack(attacks, line):
    m = NGINX_LINE.match(line)
    if not m or not public_ip(m.group(1)):
        return
    ip, when, request, status, agent = m.groups()
    parts = request.split(" ")
    path = parts[1] if len(parts) >= 2 else request
    if len(parts) >= 2 and path.startswith("/") and not PROBES.search(path):
        return
    r = attacks.hit("web", ip)
    attacks.seen(r, nginx_ms(when))
    attacks.bump(r, "paths", f"{parts[0][:10]} {path[:120]}" if len(parts) >= 2 else request[:120] or "(vacía)")
    attacks.bump(r, "status", status)
    if agent and agent != "-":
        r.setdefault("agent", agent[:120])


COWRIE_EVENTS = {
    "cowrie.session.connect",
    "cowrie.login.failed",
    "cowrie.login.success",
    "cowrie.command.input",
    "cowrie.session.file_download",
    "cowrie.session.file_upload",
    "cowrie.client.version",
}


def cowrie_attack(attacks, line):
    try:
        e = json.loads(line)
    except ValueError:
        return
    ip = e.get("src_ip")
    # Las conexiones desde la LAN son pruebas de Alex (o el NAT del router): no son ataques.
    if not ip or not public_ip(ip):
        return
    kind = "telnet" if e.get("protocol") == "telnet" or e.get("dst_port") == 2223 else "ssh"
    ev = e.get("eventid", "")
    if ev in COWRIE_EVENTS:
        attacks.seen(attacks.hit(kind, ip, 0), iso_ms(e.get("timestamp")))
    if ev == "cowrie.session.connect":
        r = attacks.hit(kind, ip, 0)
        r["sessions"] = r.get("sessions", 0) + 1
    elif ev in ("cowrie.login.failed", "cowrie.login.success"):
        r = attacks.hit(kind, ip)
        user = str(e.get("username", ""))[:40]
        attacks.bump(r, "users", user)
        attacks.bump(r, "creds", f"{user}:{str(e.get('password', ''))[:40]}")
        if ev == "cowrie.login.success":
            r["logins_ok"] = r.get("logins_ok", 0) + 1
    elif ev == "cowrie.command.input":
        attacks.push(attacks.hit(kind, ip, 0), "commands", str(e.get("input", ""))[:200])
    elif ev == "cowrie.session.file_download":
        attacks.push(
            attacks.hit(kind, ip, 0),
            "downloads",
            {"url": str(e.get("url", ""))[:300], "sha256": e.get("shasum")},
        )
    elif ev == "cowrie.session.file_upload":
        # Lo que suben por SCP/SFTP (p. ej. un binario oculto en /root): Cowrie
        # guarda la copia en var/lib/cowrie/downloads con su sha256 como nombre.
        attacks.push(
            attacks.hit(kind, ip, 0),
            "downloads",
            {"url": f"subido: {str(e.get('filename', '?'))[:280]}", "sha256": e.get("shasum")},
        )
    elif ev == "cowrie.client.version":
        attacks.hit(kind, ip, 0).setdefault("client", str(e.get("version", ""))[:120])


def tail_lines(path, state):
    """Líneas nuevas de un log desde la última pasada; sigue la rotación por inodo."""
    try:
        st = os.stat(path)
    except OSError:
        return []
    prev = state.get(path, {})
    same = prev.get("inode") == st.st_ino and prev.get("pos", 0) <= st.st_size
    pos = prev.get("pos", 0) if same else 0
    with open(path, "rb") as f:
        f.seek(pos)
        data = f.read(MAX_TAIL_BYTES)
    end = data.rfind(b"\n") + 1  # solo líneas completas
    state[path] = {"inode": st.st_ino, "pos": pos + end}
    return data[:end].decode("utf-8", "replace").splitlines()


def log_batch(tail_state):
    """Avisos del journal y ataques desde la última pasada. Devuelve (lote, cursor nuevo)."""
    try:
        with open(JOURNAL_CURSOR) as f:
            cursor = f.read().strip() or None
    except FileNotFoundError:
        cursor = None
    seed = cursor is None
    rc, entries = read_journal(["--since", SEED_SINCE] if seed else ["--after-cursor", cursor])
    if rc != 0 and not entries:
        # Cursor que ya no existe (journal rotado): seguir desde hace poco.
        rc, entries = read_journal(["--since", "-10min"])

    groups = {}
    ufw_blocks = 0
    attacks = Attacks()
    last_cursor = cursor
    for e in entries:
        last_cursor = e.get("__CURSOR", last_cursor)
        msg = message_text(e.get("MESSAGE"))
        if msg.startswith("[UFW "):
            # Casi todo es multicast de la LAN: el router solo deja pasar puertos
            # que ufw ya permite. Solo se cuentan.
            ufw_blocks += 1
            continue
        if e.get("_SYSTEMD_UNIT") == "wings.service":
            wings_attack(attacks, msg, journal_ms(e))
        if not interesting(e, msg):
            continue
        unit = unit_name(e)
        template = normalize(msg)[:200]
        fp = hashlib.sha1(f"{unit}|{template}".encode()).hexdigest()[:10]
        g = groups.get(fp)
        if g is None:
            groups[fp] = {
                "fp": fp,
                "unit": unit,
                "template": template,
                "sample": mask(msg)[:300],
                "priority": int(e.get("PRIORITY", 6)),
                "count": 1,
            }
        else:
            g["count"] += 1

    for line in tail_lines(NGINX_LOG, tail_state):
        nginx_attack(attacks, line)
    for line in tail_lines(COWRIE_LOG, tail_state):
        cowrie_attack(attacks, line)

    batch = {
        "id": int(time.time()),
        "at": datetime.now(timezone.utc).isoformat(),
        "seed": seed,
        "ufw_blocks": ufw_blocks,
        "patterns": sorted(groups.values(), key=lambda g: -g["count"])[:MAX_PATTERNS_PER_BATCH],
        "attacks": attacks.out(),
        "sftp_failed_other": attacks.sftp_failed_other,
        "own_ips": sorted(own_ips()),
    }
    return batch, last_cursor


def write_json(name, data):
    os.makedirs(OUT_DIR, exist_ok=True)
    tmp = os.path.join(OUT_DIR, f".{name}.{os.getpid()}")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.chmod(tmp, 0o640)
    try:
        shutil.chown(tmp, group="opsbot")
    except (LookupError, PermissionError):
        pass  # sin el grupo (p. ej. en pruebas) queda solo para root
    os.replace(tmp, os.path.join(OUT_DIR, name))  # atómico


STATS_KEEP_MS = 31 * 86_400_000
STATS_REBUILD_KINDS = ["sftp", "web", "ssh", "telnet"]


def log_files(path):
    """El log y sus rotaciones (.1, .2.gz…, cowrie.json.AAAA-MM-DD), el actual al final."""
    import glob

    return sorted((p for p in glob.glob(path + ".*") if p != path), key=os.path.getmtime) + [path]


def read_upto(path, tail_state):
    """Líneas de un log; del actual, solo hasta donde ya leyeron las pasadas normales."""
    import gzip

    limit = None
    prev = tail_state.get(path)
    try:
        st = os.stat(path)
    except OSError:
        return
    if path in tail_state:
        limit = prev.get("pos", 0) if prev.get("inode") == st.st_ino else 0
    opener = gzip.open if path.endswith(".gz") else open
    read = 0
    with opener(path, "rb") as f:
        for raw in f:
            read += len(raw)
            if limit is not None and read > limit:
                return
            yield raw.decode("utf-8", "replace")


def stats_rebuild(tail_state, cursor):
    """Una vez: usuarios, credenciales, comandos y rutas por hora de los últimos
    31 días, sacados de los logs (cada línea trae su hora). El bot borra las
    tablas por ventana y las rehace con esto. Solo llega hasta lo ya leído por
    las pasadas normales; lo de después viene en los lotes de siempre."""
    m = re.search(r"\bt=([0-9a-f]+)", cursor or "")
    if not m:
        return None
    until = int(m.group(1), 16) // 1000
    since = until - STATS_KEEP_MS
    hours = {}

    # Cowrie y nginx ya van acotados por la posición leída; Wings, por el cursor.
    def bucket(ts, upto=None):
        if ts is None or ts < since or (upto is not None and ts > upto):
            return None
        a = hours.get(ts // 3_600_000)
        if a is None:
            a = hours[ts // 3_600_000] = Attacks()
            a.limit = 2000
        return a

    for path in log_files(COWRIE_LOG):
        for line in read_upto(path, tail_state):
            if '"timestamp"' not in line:
                continue
            try:
                a = bucket(iso_ms(json.loads(line).get("timestamp")))
            except ValueError:
                continue
            if a:
                cowrie_attack(a, line)
    for path in log_files(NGINX_LOG):
        for line in read_upto(path, tail_state):
            m = NGINX_LINE.match(line)
            a = m and bucket(nginx_ms(m.group(2)))
            if a:
                nginx_attack(a, line)
    _, entries = read_journal(["-u", "wings", "--since", "-31d"])
    for e in entries:
        ts = journal_ms(e)
        a = bucket(ts, until)
        if a:
            wings_attack(a, message_text(e.get("MESSAGE")), ts)

    records = []
    for hour, a in hours.items():
        for r in a.by.values():
            keep = {k: r[k] for k in ("kind", "ip", "count", "users", "creds", "commands", "paths") if k in r}
            keep["ts"] = r.get("ts", hour * 3_600_000)
            records.append(keep)
    return {"kinds": STATS_REBUILD_KINDS, "until": until, "attacks": records}


def collect_logs():
    try:
        with open(TAIL_STATE) as f:
            tail_state = json.load(f)
    except (FileNotFoundError, ValueError):
        tail_state = {}
    rebuild = None
    if tail_state and not tail_state.get("stats_rebuilt"):
        try:
            with open(JOURNAL_CURSOR) as f:
                rebuild = stats_rebuild(dict(tail_state), f.read().strip())
        except Exception as err:  # que nunca tumbe la pasada normal
            print(f"ops-collect: no se pudieron rehacer las tablas por ventana: {err}")
    batch, cursor = log_batch(tail_state)
    if rebuild:
        batch["stats_rebuild"] = rebuild
    tail_state["stats_rebuilt"] = True
    try:
        with open(os.path.join(OUT_DIR, "logs.json")) as f:
            batches = json.load(f).get("batches", [])
    except (FileNotFoundError, ValueError):
        batches = []
    batches = (batches + [batch])[-KEEP_LOG_BATCHES:]
    write_json("logs.json", {"batches": batches})
    # Los cursores se guardan después: si algo falla antes, la próxima pasada relee.
    if cursor:
        with open(JOURNAL_CURSOR, "w") as f:
            f.write(cursor)
    with open(TAIL_STATE, "w") as f:
        json.dump(tail_state, f)
    return batch


def backfill_attacks():
    """Una vez: ataques al SFTP de Wings de los últimos 7 días, como lote semilla
    (cuenta en los totales e IPs, no en la línea de tiempo). Para cuando el
    aprendizaje inicial lo hizo una versión que aún no extraía ataques."""
    rc, entries = read_journal(["-u", "wings", "--since", SEED_SINCE])
    attacks = Attacks()
    for e in entries:
        wings_attack(attacks, message_text(e.get("MESSAGE")))
    batch = {
        "id": int(time.time()),
        "at": datetime.now(timezone.utc).isoformat(),
        "seed": True,
        "ufw_blocks": 0,
        "patterns": [],
        "attacks": attacks.out(),
        "sftp_failed_other": attacks.sftp_failed_other,
    }
    try:
        with open(os.path.join(OUT_DIR, "logs.json")) as f:
            batches = json.load(f).get("batches", [])
    except (FileNotFoundError, ValueError):
        batches = []
    write_json("logs.json", {"batches": (batches + [batch])[-KEEP_LOG_BATCHES:]})
    total = sum(a["count"] for a in batch["attacks"])
    print(f"ops-collect: recuperados {total} intentos de {len(batch['attacks'])} IPs (journalctl rc={rc})")


def backfill_cowrie_files():
    """Una vez: archivos subidos o descargados en el honeypot que ya estaban en
    los logs de Cowrie antes de que el recolector supiera leerlos. Entran como
    lote semilla (en la tabla de archivos cazados, sin feed ni aviso)."""
    import glob

    attacks = Attacks()
    for path in sorted(glob.glob(COWRIE_LOG + "*")):
        with open(path, errors="replace") as f:
            for line in f:
                if '"cowrie.session.file_' in line:
                    cowrie_attack(attacks, line)
    batch = {
        "id": int(time.time()),
        "at": datetime.now(timezone.utc).isoformat(),
        "seed": True,
        "ufw_blocks": 0,
        "patterns": [],
        "attacks": attacks.out(),
        "sftp_failed_other": 0,
    }
    try:
        with open(os.path.join(OUT_DIR, "logs.json")) as f:
            batches = json.load(f).get("batches", [])
    except (FileNotFoundError, ValueError):
        batches = []
    write_json("logs.json", {"batches": (batches + [batch])[-KEEP_LOG_BATCHES:]})
    files = sum(len(a.get("downloads", [])) for a in batch["attacks"])
    print(f"ops-collect: recuperados {files} archivos del honeypot de {len(batch['attacks'])} IPs")


def main():
    snapshot = {
        "collected_at": datetime.now(timezone.utc).isoformat(),
        "system": section(system),
        "smart": section(smart),
        "services": section(services),
        "backups": section(backups),
        "containers": section(clients),
        "certificates": section(certificates),
        "simulacro": section(simulacro),
        "deploys": section(deploys),
        "fail2ban": section(fail2ban),
        "wings": section(wings),
        "wings_remote": section(wings_remote),
    }
    write_json("snapshot.json", snapshot)
    logs = section(collect_logs)
    if "error" in logs:
        print(f"ops-collect: logs: {logs['error']}")
    else:
        print(
            f"ops-collect: logs: {len(logs['patterns'])} huellas, {logs['ufw_blocks']} bloqueos de ufw, "
            f"{len(logs['attacks'])} atacantes"
        )


if __name__ == "__main__":
    import sys

    start = time.monotonic()
    if sys.argv[1:] == ["--backfill-attacks"]:
        backfill_attacks()
    elif sys.argv[1:] == ["--backfill-cowrie-files"]:
        backfill_cowrie_files()
    else:
        main()
    print(f"ops-collect: ok en {time.monotonic() - start:.1f} s")
